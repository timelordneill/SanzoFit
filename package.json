  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.0",
    "json-server": "^1.0.0-beta.15",
    "prettier": "^3.8.1",
